<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="generator" content="avsd report">
<title>AVSD results browser</title>
<script>
(function () {
  var d = document.documentElement, tabs = {{ tab_labels.keys()|list|tojson }};
  var t = (location.hash || "").slice(1);
  d.className += " js";
  d.setAttribute("data-tab", tabs.indexOf(t) >= 0 ? t : "overview");
  try { var m = localStorage.getItem("avsd-theme"); if (m === "light" || m === "dark") d.setAttribute("data-theme", m); } catch (e) {}
})();
</script>
<style>
{{ css }}
{% for token in tab_labels %}html.js[data-tab="{{ token }}"] #tab-{{ token }}{{ "," if not loop.last }}
{% endfor %}{ display: block; }
</style>
</head>
<body>
{% macro pill(status) -%}
<span class="pill {{ status_css.get(status, 'other') }}">{{ status }}</span>
{%- endmacro %}
{% macro card(c, inner=False) %}
<section class="card card-{{ c.kind }}">
  {% if not inner %}
  <header class="card-head">
    <h3>{{ c.title }}</h3>
    <p class="src">Source <code>{{ c.src }}</code>{% if c.meta %}<span class="dot">·</span>{{ c.meta }}{% endif %}</p>
  </header>
  {% endif %}
  {% if c.note %}<p class="note">{{ c.note }}</p>{% endif %}
  {% if c.kind == "figure" %}
  <figure class="fig"><img src="{{ c.img }}" alt="{{ c.title }}" class="zoomable" decoding="async">
    <figcaption>Click the image for full size</figcaption></figure>
  {% elif c.kind == "table" %}
  <div class="tbl" id="{{ c.widget }}" data-src="{{ c.data_id }}"><p class="loading">Loading table…</p></div>
  {% elif c.kind == "chart" %}
  <div class="cpchart" id="{{ c.widget }}" data-src="{{ c.data_id }}"><p class="loading">Loading chart…</p></div>
  {% elif c.kind == "html" %}
  <div class="md">{{ c.html }}</div>
  {% endif %}
</section>
{% endmacro %}
{% macro listed_files(items) %}
<ul class="listed">
  {% for f in items %}
  <li><code>outputs/{{ f.rel }}</code><span class="meta">{{ fmt_size(f.size) }} · updated {{ f.mtime.strftime("%Y-%m-%d %H:%M") }}</span>
    <span class="why">{{ f.why or "This type is not embedded" }}</span></li>
  {% endfor %}
</ul>
{% endmacro %}
{% macro others_section(cards, listed) %}
{% if cards or listed %}
<section class="others">
  <h3>Other files</h3>
  <p class="hint">Outputs assigned to this page by file name that have no description yet. Click to open.</p>
  {% for c in cards %}
  <details class="other">
    <summary><span class="other-name">{{ c.title }}</span><span class="meta">{{ c.meta }}</span></summary>
    {{ card(c, inner=True) }}
  </details>
  {% endfor %}
  {% if listed %}{{ listed_files(listed) }}{% endif %}
</section>
{% endif %}
{% endmacro %}

<header class="topbar">
  <div class="topbar-inner">
    <div class="brand"><span class="brand-mark" aria-hidden="true"></span>AVSD results browser</div>
    <div class="build">Built <time datetime="{{ built_iso }}">{{ built }}</time> ({{ weekday }})</div>
    <button class="theme-btn" type="button" id="theme-btn" title="Switch between light, dark or system theme">Theme: auto</button>
  </div>
  <nav class="tabs" role="tablist" aria-label="Report tabs">
    {% for token, label in tab_labels.items() %}
    <a class="tab" role="tab" href="#{{ token }}" id="tabbtn-{{ token }}" data-tab="{{ token }}" aria-controls="tab-{{ token }}">{{ label }}</a>
    {% endfor %}
  </nav>
</header>

<main class="wrap">
<section class="panel" id="tab-overview" role="tabpanel" aria-labelledby="tabbtn-overview" data-panel="overview">
  <h2 class="panel-title">Overview</h2>
  <p class="intro">Results of the AI Village swarm dynamics analysis. This page reads only the aggregate results in outputs/ and PROGRESS.md, never data/.
    New outputs appear after the next run of <code>avsd report</code> .</p>
  <div class="tiles">
    <div class="tile">
      <div class="tile-label">Task status{% if has_progress %}<span class="tile-sub">PROGRESS.md · {{ progress_mtime }}</span>{% endif %}</div>
      {% if has_progress %}
      <div class="tile-statuses">{% for s, css, n in statuses %}<span class="status-count">{{ pill(s) }}<b>{{ n }}</b></span>{% endfor %}</div>
      {% else %}<div class="tile-value muted">PROGRESS.md not found</div>{% endif %}
    </div>
    <div class="tile">
      <div class="tile-label">Output files</div>
      <div class="tile-value">{{ n_files }}</div>
      <div class="tile-sub">qa/ {{ counts.qa }} · tables/ {{ counts.tables }} · figures/ {{ counts.figures }}</div>
    </div>
    <div class="tile">
      <div class="tile-label">Last updated</div>
      {% if latest %}<div class="tile-value small">{{ latest.time }}</div><div class="tile-sub"><code>{{ latest.rel }}</code></div>
      {% else %}<div class="tile-value muted">Not produced yet</div>{% endif %}
    </div>
  </div>

  <h3 class="section-title">Analyses</h3>
  <div class="modgrid">
    {% for p in panels %}
    <a class="modcard{% if not p.n_files %} is-empty{% endif %}" href="#{{ p.tab.token }}">
      <span class="modcard-head"><span class="modcard-label">{{ p.tab.label }}</span>
        <span class="modcard-count" title="Main files produced / expected">{{ p.n_known }}/{{ p.n_expected }}</span></span>
      <span class="modcard-title">{{ p.tab.title }}</span>
      {% if p.status %}<span class="modcard-status">
        {% if p.status_counts %}<span class="status-counts">{% for s, n in p.status_counts %}<span class="status-count">{{ pill(s) }}<b>{{ n }}</b></span>{% endfor %}</span>{% endif %}
        {% for task, status in p.status_brief %}<span class="task">{{ pill(status) }}<span class="task-name">{{ task }}</span></span>{% endfor %}
      </span>{% endif %}
      <span class="modcard-foot">{% if p.n_files %}{{ p.n_files }} files · last updated {{ p.latest }}{% else %}Not produced yet{% endif %}</span>
    </a>
    {% endfor %}
  </div>

  <h3 class="section-title">Task status{% if has_progress %}<span class="sub">from PROGRESS.md</span>{% endif %}</h3>
  {% if task_sections %}
  {% for s in task_sections %}
  <section class="card"><h4 class="card-subtitle">{{ s.title }}</h4>{{ s.html }}</section>
  {% endfor %}
  {% else %}
  <section class="card missing"><p>Not produced yet: PROGRESS.md has no task table with a Status column.</p></section>
  {% endif %}

  <h3 class="section-title">Work log{% if log %}<span class="sub">latest {{ [log.n, 10]|min }} entries, newest first</span>{% endif %}</h3>
  {% if log %}
  <section class="card">{{ log.recent }}
    {% if log.rest %}<details class="more"><summary>Show the other {{ log.n - 10 }} entries</summary>{{ log.rest }}</details>{% endif %}
  </section>
  {% else %}
  <section class="card missing"><p>Not produced yet: PROGRESS.md has no work-log table.</p></section>
  {% endif %}

  <h3 class="section-title">All output files<span class="sub">outputs/qa, outputs/tables, outputs/figures</span></h3>
  <section class="card">
    {% if n_files %}<div class="tbl" id="{{ index_widget }}"><p class="loading">Loading table…</p></div>
    {% else %}<p class="muted">Not produced yet: outputs/ has no QA reports, tables or figures.</p>{% endif %}
  </section>
  {{ others_section(overview_others, overview_listed) }}
</section>

{% for p in panels %}
<section class="panel" id="tab-{{ p.tab.token }}" role="tabpanel" aria-labelledby="tabbtn-{{ p.tab.token }}" data-panel="{{ p.tab.token }}">
  <h2 class="panel-title">{{ p.tab.title }}</h2>
  <p class="intro">{{ p.tab.intro }}</p>
  {% if p.status or p.qa %}
  <div class="panel-meta">
    {% if p.status %}<div class="status-row">{% for task, status in p.status %}<span class="task">{{ pill(status) }}<span class="task-name">{{ task }}</span></span>{% endfor %}</div>{% endif %}
    {% if p.qa %}<div class="qa-links">QA report:{% for s in p.qa %}<a href="#qa" data-qa="{{ s }}">{{ s }}.md</a>{% endfor %}</div>{% endif %}
  </div>
  {% endif %}
  {% for c in p.cards %}{{ card(c) }}{% endfor %}
  {% if not p.cards %}
  <section class="card empty"><p>This analysis has no outputs yet. The expected files are listed below; rerun <code>avsd report</code> once they exist.</p></section>
  {% endif %}
  {% if p.missing %}
  <section class="card missing">
    <h3>Not produced yet</h3>
    <ul>{% for path, desc in p.missing %}<li><code>{{ path }}</code><span>{{ desc }}</span></li>{% endfor %}</ul>
  </section>
  {% endif %}
  {{ others_section(p.others, p.listed) }}
</section>
{% endfor %}

<section class="panel" id="tab-qa" role="tabpanel" aria-labelledby="tabbtn-qa" data-panel="qa">
  <h2 class="panel-title">QA reports</h2>
  <p class="intro">All QA reports under outputs/qa/ (rendered markdown) in pipeline order, pilot runs last. Click a column header to sort.</p>
  {% if qa_reports %}
  <div class="qa-layout">
    <nav class="qa-nav" aria-label="QA reports">
      {% for r in qa_reports %}
      <button type="button" class="qa-item" data-qa="{{ r.stem }}"><span class="qa-file">{{ r.file }}</span><span class="qa-meta">{{ r.meta }}</span></button>
      {% endfor %}
    </nav>
    <label class="qa-select-wrap">Choose a report
      <select class="qa-select">{% for r in qa_reports %}<option value="{{ r.stem }}">{{ r.file }}</option>{% endfor %}</select>
    </label>
    <div class="qa-body">
      {% for r in qa_reports %}
      <article class="qa-report md card" id="{{ r.id }}" data-qa-report="{{ r.stem }}"{% if not loop.first %} hidden{% endif %}>
        <p class="src">Source <code>outputs/qa/{{ r.file }}</code><span class="dot">·</span>{{ r.meta }}</p>
        {% if r.toc|length > 2 %}
        <nav class="toc" aria-label="Contents"><span class="toc-label">Contents</span>{% for hid, t in r.toc %}<button type="button" data-scroll="{{ hid }}">{{ t }}</button>{% endfor %}</nav>
        {% endif %}
        {{ r.html }}
      </article>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <section class="card missing"><h3>Not produced yet</h3><ul><li><code>outputs/qa/*.md</code><span>QA reports of each step</span></li></ul></section>
  {% endif %}
</section>
</main>

<footer class="foot wrap">
  <p>Data: AI Digest, "AI Village dataset", 2026, https://theaidigest.org/village</p>
  <p>Generated by <code>avsd report</code>. Only aggregate results from outputs/; columns named like text, content, heading, summary, evidence or email are never shown.</p>
</footer>

<div class="lightbox" id="lightbox" hidden><div class="lightbox-inner"><img alt=""></div><button type="button" class="lightbox-close">Close</button></div>
{% for id, text in data_blocks.items() %}
<script type="application/json" id="{{ id }}">{{ text|safe }}</script>
{% endfor %}
<script type="application/json" id="avsd-views">{{ views }}</script>
<script>
{{ js }}
</script>
</body>
</html>
